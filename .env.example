# ---------------------------------------------------------------------------
# Rihab Baabou · configuration. Copiez ce fichier en .env et adaptez les valeurs.
# Ne publiez jamais le fichier .env (il est ignoré par git).
# ---------------------------------------------------------------------------

# Environnement : development | production
NODE_ENV=development

# Port du serveur Express (API + site construit en production)
PORT=4000

# Connexion MongoDB (local, Docker ou MongoDB Atlas)
#   local  : mongodb://127.0.0.1:27017/rihab
#   Atlas  : mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster.xxxxx.mongodb.net/rihab
MONGODB_URI=mongodb://127.0.0.1:27017/rihab

# Premier administrateur, créé au démarrage s'il n'en existe aucun.
# Mot de passe : 10 caractères minimum. Une fois le compte créé, vous pouvez retirer ADMIN_PASSWORD.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-moi-avant-la-mise-en-ligne

# Durée d'une session d'administration, en heures
SESSION_TTL_HOURS=12

# Cookie de session réservé au HTTPS. Par défaut : true en production, false en développement.
# COOKIE_SECURE=true

# Derrière un proxy ou un hébergeur (Render, Railway, Nginx…), indiquez le nombre de proxys (souvent 1)
# pour que l'adresse IP réelle soit utilisée par la limite de tentatives de connexion.
# TRUST_PROXY=1

# Taille maximale d'une image envoyée, en Mo
MAX_UPLOAD_MB=10

# Tentatives de connexion autorisées par adresse IP et par fenêtre (minutes)
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Dossier du site React construit, relatif à la racine du projet
# CLIENT_DIST=client/dist
